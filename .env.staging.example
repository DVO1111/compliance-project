# Staging environment — copy this to .env.staging and fill in your staging Supabase project values.
# NEVER commit .env.staging — it is in .gitignore.
#
# How to get these values:
#   1. Go to https://supabase.com/dashboard and create a NEW project for staging
#      (e.g. "compliance-os-staging")
#   2. Once created: Project Settings > API
#      - Copy "Project URL" → VITE_SUPABASE_URL
#      - Copy "anon public" key → VITE_SUPABASE_ANON_KEY
#   3. Apply all migrations to the staging project:
#      npx supabase db push --db-url <your-staging-db-url>

# Staging Supabase project
VITE_SUPABASE_URL=https://your-staging-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-staging-anon-key-here

# Sentry (optional — use a separate Sentry environment or leave blank)
VITE_SENTRY_DSN=
